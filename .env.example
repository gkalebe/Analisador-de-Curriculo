ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://analisador:analisador@localhost:5432/analisador_curriculos
SECRET_KEY=troque-por-uma-chave-secreta-forte
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-haiku-20241022
MAX_UPLOAD_SIZE_MB=5
MAX_VAGA_DESCRIPTION_CHARS=5000
# Origens autorizadas a chamar a API (CORS), separadas por vírgula. Em produção, usar o
# domínio real do front-end publicado — nunca deixar a API aberta para qualquer origem.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
FRONTEND_LOGIN_URL=http://localhost:8000/login
FRONTEND_RESET_PASSWORD_URL=http://localhost:8000/usuarios/redefinir-senha
# SMTP_HOST vazio = e-mails são apenas registrados em log (modo dev), sem provedor definido ainda
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Vazio = fallback para SMTP/log (ver EmailAdapter em app/adapters/email/)
SENDGRID_API_KEY=
